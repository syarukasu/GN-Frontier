# Historical tools depend on local revision evidence; use the maintained entry point.
/tools/*
!/tools/project.py
!/tools/build_release.py
!/tools/verify_repository.py
!/tools/test_distribution.py
/docs/*
!/docs/VERSIONING.md
!/docs/DEVELOPMENT.md
!/docs/STATUS.md
!/docs/CURSEFORGE.md
!/docs/SERVER.md
