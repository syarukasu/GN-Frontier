# Local builds, downloaded originals, evidence and private launcher state
/.cache/
/backups/
/dist/
/evidence/
/local-downloads/
/local/
/revisions/
**/build/
**/.gradle/
**/logs/
**/crash-reports/
**/__pycache__/
*.pyc
*.class
*.jar
!addon/gradle/wrapper/gradle-wrapper.jar
*.zip
*.log
*.jfr
*.hprof
*.part
**/saves/
**/accounts.json
**/servers.dat*
**/session.lock
**/.env*
**/*token*.txt
